                                        "type": "string",
                                        "example": "123 Main St"
                                    },
                                    "driver_id": {
                                        "description": "Optional for automatic mode",
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
