        "/api/v1/delivery/scan": {
            "post": {
                "tags": [
                    "Delivery"
                ],
                "summary": "Identify package via QR scan and handle automatic/manual assignment",
                "operationId": "1c5de35ff0146cfcc0ec6856ff7fd842",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "package_reference": {
                                        "type": "string",
                                        "example": "PKG-12345"
                                    },
                                    "driver_id": {
                                        "description": "Optional for manual assignment from frontend",
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Package identified and potentially assigned"
                    },
                    "404": {
                        "description": "Package not found"
                    },
                    "422": {
                        "description": "Package already assigned or no drivers available"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/delivery/assign": {
            "post": {
                "tags": [
                    "Delivery"
                ],
                "summary": "Manually assign package to driver",
                "operationId": "eb2479d4d3cfb478487191f383abbbb1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "package_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "driver_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Package assigned successfully"
                    },
                    "422": {
                        "description": "Constraints violated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
