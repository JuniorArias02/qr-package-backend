                                                    "example": 4.60971
                                                },
                                                "longitude": {
                                                    "type": "number",
                                                    "example": -74.08175
                                                },
                                                "radius_km": {
                                                    "type": "number",
                                                    "example": 3.5
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
